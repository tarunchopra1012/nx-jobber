generator client {
  provider            = "prisma-client"
  output              = "../src/app/prisma/generated"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id       @default(autoincrement())
  email     String   @unique
  password  String
}
